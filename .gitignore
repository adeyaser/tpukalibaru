# CodeIgniter 4 .gitignore
# --------------------------------------------------------------------

# Environment-specific files
.env
.env.*
!.env.example

# Composer files
vendor/

# Writable directory
writable/cache/*
writable/debugbar/*
writable/logs/*
writable/session/*
writable/uploads/*
!writable/cache/.gitkeep
!writable/debugbar/.gitkeep
!writable/logs/.gitkeep
!writable/session/.gitkeep
!writable/uploads/.gitkeep

# IDE files
.idea/
.vscode/

# System files
.DS_Store
Thumbs.db

# User uploads (if any)
public/uploads/*
!public/uploads/.gitkeep
